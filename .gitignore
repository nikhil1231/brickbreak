# macOS
.DS_Store

# secrets
.env
*.session

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# data — do not commit datasets or vendor masters
data/raw/*
data/normalized/*
data/metadata/*
!data/**/.gitkeep
# ...except the frozen definitions and the holdout result. These are evidence,
# not data: they are a few tens of KB, and the "open the holdout once" guarantee
# is enforced by comparing a hash against `family_holdout.json`. A guard that
# lives only in an ignored directory is one `rm` away from not existing.
!data/metadata/*_frozen.json
!data/metadata/family_holdout.json
!data/metadata/resilience_semi_stale.json
# Frozen intraday request manifests are evidence and remain trackable; fetched
# vendor bytes and resumable machine-local checkpoints are not source control.
data/intraday_acquisition/*/raw/
data/intraday_acquisition/*/normalised/
data/intraday_acquisition/*/attempts/
data/intraday_acquisition/*/session_markers/
data/intraday_acquisition/*/closing_markers/
data/intraday_acquisition/*/pull_status.json
logs/
data/whatsapp_gc/

# frontend
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
# In-progress human reviews are local checkpoints; only finalized annotations
# in the frozen bundle are research evidence.
data/metadata/research_store/**/human_drafts/
data/metadata/research_store/**/.review.lock

# local tooling and scratch
.claude/
tmp/
output/
