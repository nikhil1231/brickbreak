# ICICI Direct Breeze API credentials.
# Register an app at https://api.icicidirect.com/apiuser/home to obtain key/secret.

# Long-lived: from the Breeze app registration page.
BREEZE_API_KEY=your_api_key_here
BREEZE_API_SECRET=your_api_secret_here

# SHORT-LIVED (expires daily, ~midnight IST). Obtain by:
#   1. python -m src.cli login-url
#   2. Open the printed URL, log in with your ICICI Direct credentials + OTP/TOTP.
#   3. After login you land on your registered redirect URL. Copy the
#      `apisession` / `API_Session` query-parameter value from that URL.
#   4. Paste it below (numeric string).
# Or run `python -m src.cli serve`, open Settings in the web app, register the
# displayed callback URL once, and use the Connect/Refresh Breeze button.
BREEZE_SESSION_TOKEN=

# Optional: Base32 authenticator seed used to show a locally generated,
# auto-refreshing TOTP code on the Breeze Settings card. The seed stays in
# Python and is never returned to the browser.
BREEZE_TOTP_SECRET=
